enum CrmEntityType {
  contact
  company
  opportunity
  pipeline
  pipeline_stage
  estimate
  appointment
  task
  note
  conversation
  message
  tag
}

enum StageOutcome {
  open
  won
  lost
}

enum EstimateStatus {
  draft
  sent
  accepted
  declined
  expired
}

enum AppointmentStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum TaskStatus {
  open
  in_progress
  completed
  cancelled
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

enum ConversationChannel {
  email
  sms
  phone
  web
  other
}

enum ConversationStatus {
  open
  closed
}

enum MessageDirection {
  inbound
  outbound
  internal
}

enum MessageStatus {
  recorded
  draft
  sent
  delivered
  failed
}

enum CustomFieldType {
  text
  number
  boolean
  date
  single_select
  multi_select
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  externalSubject String               @unique
  name            String?
  email           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  memberships     OrganizationMember[]
}

// A typed, tenant-owned identity for polymorphic relationships. Domain rows keep their IDs.
model CrmRecord {
  recoveryAttributions RecoveryAttribution[]
  id                   String                  @id @db.Uuid
  organizationId       String                  @db.Uuid
  entityType           CrmEntityType
  version              Int                     @default(1)
  archivedAt           DateTime?
  assignedMemberId     String?                 @db.Uuid
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedMember       OrganizationMember?     @relation(fields: [organizationId, assignedMemberId], references: [organizationId, id], onDelete: Restrict)
  contact              Contact?
  opportunity          Opportunity?
  company              Company?
  pipeline             Pipeline?
  pipelineStage        PipelineStage?
  estimate             Estimate?
  appointment          Appointment?
  task                 Task?
  note                 Note?
  conversation         Conversation?
  message              Message?
  tag                  Tag?
  mappings             ExternalRecordMapping[]
  fields               CustomFieldValue[]
  tags                 RecordTag[]
  events               BusinessEventLink[]
  relatedTasks         Task[]                  @relation("TaskRelated")
  relatedNotes         Note[]                  @relation("NoteRelated")
  subjectEvents        BusinessEvent[]         @relation("EventSubject")
  agentRuns            AgentRun[]
  agentSchedules       AgentSchedule[]

  @@unique([organizationId, id])
  @@unique([organizationId, id, entityType])
  @@index([organizationId, entityType, archivedAt, id])
  @@index([organizationId, assignedMemberId])
}

model ExternalRecordMapping {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  connectionId       String             @db.Uuid
  provider           String
  externalRecordType String
  externalId         String
  internalEntityType CrmEntityType
  internalEntityId   String             @db.Uuid
  sourceUpdatedAt    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connection         ExternalConnection @relation(fields: [organizationId, connectionId, provider], references: [organizationId, id, provider], onDelete: Restrict)
  record             CrmRecord          @relation(fields: [organizationId, internalEntityId, internalEntityType], references: [organizationId, id, entityType], onDelete: Restrict)

  @@unique([organizationId, connectionId, externalRecordType, externalId])
  @@index([organizationId, internalEntityType, internalEntityId])
}

model CustomFieldDefinition {
  id             String             @id @default(uuid()) @db.Uuid
