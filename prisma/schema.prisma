model LeadOutreachState {
  id                  String              @id @default(uuid()) @db.Uuid
  leadId              String              @unique @map("lead_id") @db.Uuid
  disposition         OutreachDisposition @default(not_contacted)
  contactable         Boolean             @default(true)
  doNotContactReason  String?             @map("do_not_contact_reason")
  lastContactedAt     DateTime?           @map("last_contacted_at")
  nextContactAt       DateTime?           @map("next_contact_at")
  contactAttemptCount Int                 @default(0) @map("contact_attempt_count")
  lastChannel         OutreachChannel?    @map("last_channel")
  lastOutcome         String?             @map("last_outcome")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([disposition, nextContactAt])
  @@index([contactable, nextContactAt])
}

model OutreachActivity {
  id         String            @id @default(uuid()) @db.Uuid
  clientId   String            @map("client_id") @db.Uuid
  leadId     String            @map("lead_id") @db.Uuid
  channel    OutreachChannel
  direction  OutreachDirection
  provider   String?
  externalId String?           @map("external_id")
  outcome    String?
  occurredAt DateTime          @map("occurred_at")
  metadata   Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([clientId, provider, externalId])
  @@index([clientId, leadId, occurredAt])
  @@index([clientId, channel, occurredAt])
}
