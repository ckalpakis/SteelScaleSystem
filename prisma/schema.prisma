generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Operational outbox for the legacy Client boundary. System reports have neither tenant ID;
// customer jobs always have clientId, plus organizationId only when explicitly linked.
model BackgroundTask {
  id             String        @id @default(uuid()) @db.Uuid
  kind           String
  key            String        @unique
  payload        Json
  payloadHash    String
  organizationId String?       @db.Uuid
  clientId       String?       @db.Uuid
  correlationId  String        @db.Uuid
  status         String        @default("pending")
  attempts       Int           @default(0)
  availableAt    DateTime      @default(now())
  leaseToken     String?       @db.Uuid
  leasedUntil    DateTime?
  lastErrorCode  String?
  createdAt      DateTime      @default(now())
  completedAt    DateTime?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([organizationId, createdAt])
  @@index([clientId, createdAt])
}

enum DestinationType {
  zapier
  ghl_fallback
}

enum VoiceProvider {
  vapi
  retell
}

enum CallType {
  missed
  answered_by_ai
  answered_live
}

enum CallOutcome {
