model Client {
  backgroundTasks          BackgroundTask[]
  id                       String           @id @default(uuid()) @db.Uuid
  businessName             String           @map("business_name")
  phoneNumber              String           @unique @map("phone_number")
  timezone                 String
  services                 String[]
  missedCallSmsTemplate    String           @default("Hey, sorry we missed your call! This is {business_name} — reply here and we'll get you booked in.") @map("missed_call_sms_template")
  noBookingSmsTemplate     String           @default("Thanks for calling {business_name}. Would you like to schedule your appointment by text? Reply here and I can help. Reply STOP to opt out.") @map("no_booking_sms_template")
  smsBookingEnabled        Boolean          @default(false) @map("sms_booking_enabled")
  ownerNotificationNumber  String?          @map("owner_notification_number")
  notifyBookingSms         Boolean          @default(true) @map("notify_booking_sms")
  notifyMissedCallSms      Boolean          @default(true) @map("notify_missed_call_sms")
  notifyUnbookedCallSms    Boolean          @default(true) @map("notify_unbooked_call_sms")
  notifyFailedBookingSms   Boolean          @default(true) @map("notify_failed_booking_sms")
  notifyTransferFailureSms Boolean          @default(true) @map("notify_transfer_failure_sms")
  dailySummarySms          Boolean          @default(true) @map("daily_summary_sms")
  createdAt                DateTime         @default(now()) @map("created_at")

  destination           ClientDestination?
  voiceAgentConfig      VoiceAgentConfig?
  callLogs              CallLog[]
  bookingAttempts       BookingAttempt[]
  chatSessions          ChatSession[]
  leads                 Lead[]
  prospectBusinesses    ProspectBusiness[]
  prospectContacts      ProspectContact[]
  leadSourceRecords     LeadSourceRecord[]
  leadSignals           LeadSignal[]
  ingestionRuns         IngestionRun[]
  enrichmentRuns        EnrichmentRun[]
  websiteAudits         WebsiteAudit[]
  realEstateListings    RealEstateListing[]
  realEstateAgents      RealEstateAgent[]
  listingSourceRecords  RealEstateListingSourceRecord[]
  scoreSnapshots        ScoreSnapshot[]
  offerRecommendations  OfferRecommendation[]
  offerSuppressions     OfferSuppression[]
  outreachActivities    OutreachActivity[]
  pipelineRuns          PipelineRun[]
  deliveryCampaigns     DeliveryCampaign[]
  deliveryRecords       DeliveryRecord[]
  callQueueEntries      CallQueueEntry[]
  callAttempts          CallAttempt[]
  availabilityChecks    AvailabilityCheck[]
  ownerNotifications    OwnerNotification[]
  smsConversations      SmsConversation[]
  workforceOrganization Organization?
}

// Workforce is additive: legacy Client data remains authoritative for existing features.
// Recovery lifecycle is separate from the generic execution journal and legacy recovery.
model RecoveryProgram {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @unique @db.Uuid
  agentId          String              @db.Uuid
  runtimeVersionId String              @db.Uuid
  connectionId     String?             @db.Uuid
  scanCursor       String?             @db.Uuid
  nextScanAt       DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agent            WorkforceAgent      @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict)
  runtimeVersion   AgentVersion        @relation(fields: [organizationId, runtimeVersionId], references: [organizationId, id], onDelete: Restrict)
  connection       ExternalConnection? @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Restrict)
  cases            RecoveryCase[]

  @@unique([organizationId, id])
  @@unique([organizationId, agentId])
}

model RecoveryCase {
  id                  String                @id @default(uuid()) @db.Uuid
  organizationId      String                @db.Uuid
  programId           String                @db.Uuid
  opportunityId       String                @db.Uuid
  contactId           String                @db.Uuid
  conversationId      String?               @db.Uuid
  pendingRunId        String?               @db.Uuid
  latestResponseId    String?               @db.Uuid
  state               String                @default("monitoring")
  reason              String?
  revision            Int                   @default(1)
  attempts            Int                   @default(0)
  nextDueAt           DateTime?
  enrolledAt          DateTime              @default(now())
  baselineActivityAt  DateTime
  monitoredValueMinor Int
  currency            String                @db.VarChar(3)
  firstDeliveredAt    DateTime?
  lastDeliveredAt     DateTime?
  engagedAt           DateTime?
  employeeActionAt    DateTime?
  updatedAt           DateTime              @updatedAt
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program             RecoveryProgram       @relation(fields: [organizationId, programId], references: [organizationId, id], onDelete: Restrict)
  opportunity         Opportunity           @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Restrict)
  contact             Contact               @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  conversation        Conversation?         @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Restrict)
  pendingRun          AgentRun?             @relation(fields: [organizationId, pendingRunId], references: [organizationId, id], onDelete: Restrict)
  latestResponse      Message?              @relation(fields: [organizationId, latestResponseId], references: [organizationId, id], onDelete: Restrict)
  decisions           RecoveryDecision[]
  handoff             RecoveryHandoff?
  dispatches          RecoveryDispatch[]
  attributions        RecoveryAttribution[]

  @@unique([organizationId, id])
  @@unique([organizationId, opportunityId])
  @@index([organizationId, state, nextDueAt])
  @@index([organizationId, contactId])
  @@index([organizationId, conversationId])
}

model RecoveryDecision {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  caseId         String       @db.Uuid
  runId          String       @db.Uuid
  caseRevision   Int
  decision       Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  case           RecoveryCase @relation(fields: [organizationId, caseId], references: [organizationId, id], onDelete: Restrict)
  run            AgentRun     @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, runId])
}

model RecoveryHandoff {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  caseId           String              @db.Uuid
  assignedMemberId String?             @db.Uuid
  status           String              @default("open")
  reason           String
  summary          String
  revision         Int                 @default(1)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  case             RecoveryCase        @relation(fields: [organizationId, caseId], references: [organizationId, id], onDelete: Restrict)
  assignedMember   OrganizationMember? @relation(fields: [organizationId, assignedMemberId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, caseId])
  @@index([organizationId, status, updatedAt])
}

model RecoveryConsent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  contactId      String       @db.Uuid
  channel        String
  granted        Boolean      @default(false)
  evidence       String
  recordedBy     String
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact        Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, contactId, channel])
}

model RecoveryDispatch {
  communicationDelivery CommunicationDelivery?
  runtimeVersion        AgentVersion           @relation(fields: [organizationId, runtimeVersionId], references: [organizationId, id], onDelete: Restrict)
  id                    String                 @id @default(uuid()) @db.Uuid
  organizationId        String                 @db.Uuid
  caseId                String                 @db.Uuid
  actionId              String?                @db.Uuid
  requestKey            String
  body                  String
  channel               String
  actor                 String
  caseRevision          Int
  runtimeVersionId      String                 @db.Uuid
  status                String                 @default("pending")
  transportAttempts     Int                    @default(0)
  availableAt           DateTime               @default(now())
  claimTokenHash        String?
  claimedUntil          DateTime?
  providerMessageId     String?
  receiptHash           String?
  errorCode             String?
  deliveredAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  case                  RecoveryCase           @relation(fields: [organizationId, caseId], references: [organizationId, id], onDelete: Restrict)
  action                AgentAction?           @relation(fields: [organizationId, actionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, actionId])
  @@unique([organizationId, requestKey])
  @@unique([organizationId, providerMessageId])
  @@index([organizationId, status, availableAt])
}

model RecoveryAttribution {
  record           CrmRecord    @relation(fields: [organizationId, entityId], references: [organizationId, id], onDelete: Restrict)
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  caseId           String       @db.Uuid
  entityId         String       @db.Uuid
  kind             String
  status           String       @default("NOT_ATTRIBUTED")
  amountMinor      Int          @default(0)
  currency         String       @db.VarChar(3)
  evidence         Json
  paymentReference String?
  reviewedBy       String?
  reviewedAt       DateTime?
  occurredAt       DateTime
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  case             RecoveryCase @relation(fields: [organizationId, caseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, kind, entityId])
  @@unique([organizationId, paymentReference])
}

model RecoverySimulation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  scenarioKey    String?
  input          Json
  result         Json
  createdBy      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
}

model Organization {
  backgroundTasks           BackgroundTask[]
  communicationAccounts     CommunicationAccount[]
  communicationDeliveries   CommunicationDelivery[]
  communicationAttempts     CommunicationAttempt[]
  communicationSuppressions CommunicationSuppression[]
  knowledgeRevision         Int                        @default(0)
  knowledgeSources          KnowledgeSource[]
  knowledgeDocuments        KnowledgeDocument[]
  knowledgeEntries          KnowledgeEntry[]
  knowledgeVersions         KnowledgeVersion[]
  active                    Boolean                    @default(true)
  recoveryProgram           RecoveryProgram?
  recoveryCases             RecoveryCase[]
  recoveryDecisions         RecoveryDecision[]
  recoveryHandoffs          RecoveryHandoff[]
  recoveryConsents          RecoveryConsent[]
  recoveryDispatches        RecoveryDispatch[]
  recoveryAttributions      RecoveryAttribution[]
  recoverySimulations       RecoverySimulation[]
  id                        String                     @id @default(uuid()) @db.Uuid
  name                      String
  legacyClientId            String?                    @unique @db.Uuid
  createdAt                 DateTime                   @default(now())
  legacyClient              Client?                    @relation(fields: [legacyClientId], references: [id], onDelete: Restrict)
  memberships               OrganizationMember[]
  credentials               WorkforceCredential[]
  integrations              ExternalConnection[]
  customers                 Contact[]
  opportunities             Opportunity[]
  events                    BusinessEvent[]
  jobs                      WorkforceJob[]
  agents                    WorkforceAgent[]
  runs                      WorkforceRun[]
  actions                   WorkforceAction[]
  approvals                 WorkforceApproval[]
  audits                    AuditLog[]
  attributions              WorkforceRevenue[]
  timezone                  String                     @default("UTC")
  defaultCurrency           String                     @default("USD") @db.VarChar(3)
  records                   CrmRecord[]
  companies                 Company[]
  pipelines                 Pipeline[]
  stages                    PipelineStage[]
  estimates                 Estimate[]
  appointments              Appointment[]
  tasks                     Task[]
  notes                     Note[]
  conversations             Conversation[]
  messages                  Message[]
  tags                      Tag[]
  recordTags                RecordTag[]
  fieldDefinitions          CustomFieldDefinition[]
  fieldValues               CustomFieldValue[]
  externalMappings          ExternalRecordMapping[]
  eventDeliveries           EventDelivery[]
  eventIntakes              EventIntake[]
  eventLinks                BusinessEventLink[]
  webhookEndpoints          WebhookEndpoint[]
  outboundDeliveries        OutboundDelivery[]
  outboundAttempts          OutboundAttempt[]
  integrationActivity       IntegrationActivity[]
  webhookLimit              OrganizationWebhookLimit?
  agentVersions             AgentVersion[]
  agentGoals                AgentGoal[]
  agentTriggers             AgentTrigger[]
  agentPolicies             AgentPolicy[]
  agentPermissions          AgentToolPermission[]
  agentEscalations          AgentEscalationRule[]
  agentRuns                 AgentRun[]
  agentSteps                AgentStep[]
  agentActions              AgentAction[]
  humanApprovals            HumanApproval[]
  agentResults              AgentResult[]
  agentSchedules            AgentSchedule[]
  blueprints                AgentBlueprint[]
  blueprintVersions         AgentBlueprintVersion[]
  blueprintTests            AgentBlueprintTest[]
  blueprintGenerations      AgentBlueprintGeneration[]
}

model CommunicationAccount {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @db.Uuid
  connectionId         String                  @unique @db.Uuid
  provider             String
  channel              String
  sender               String
  externalAccountId    String
  encryptedCredentials String
  enabled              Boolean                 @default(false)
  revision             Int                     @default(1)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connection           ExternalConnection      @relation(fields: [organizationId, connectionId, provider], references: [organizationId, id, provider], onDelete: Restrict)
  deliveries           CommunicationDelivery[]

  @@unique([organizationId, id])
  @@unique([organizationId, channel])
  @@unique([organizationId, connectionId, provider])
  @@unique([provider, externalAccountId, sender])
}

model CommunicationDelivery {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @db.Uuid
  messageId          String                 @db.Uuid
  conversationId     String                 @db.Uuid
  contactId          String                 @db.Uuid
  accountId          String?                @db.Uuid
  connectionId       String?                @db.Uuid
  recoveryDispatchId String?                @db.Uuid
  provider           String
  channel            String
  direction          String
  actor              String
  requestKey         String
  payloadHash        String
  sender             String?
  recipient          String?
  externalId         String?
  status             String
  errorCode          String?
  attempts           Int                    @default(0)
  availableAt        DateTime               @default(now())
  leaseToken         String?                @db.Uuid
  leasedUntil        DateTime?
  acceptedAt         DateTime?
  deliveredAt        DateTime?
  statusAt           DateTime               @default(now())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  message            Message                @relation(fields: [organizationId, messageId, conversationId], references: [organizationId, id, conversationId], onDelete: Restrict)
  conversation       Conversation           @relation(fields: [organizationId, conversationId, contactId], references: [organizationId, id, contactId], onDelete: Restrict)
  contact            Contact                @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  account            CommunicationAccount?  @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  connection         ExternalConnection?    @relation(fields: [organizationId, connectionId, provider], references: [organizationId, id, provider], onDelete: Restrict)
  recoveryDispatch   RecoveryDispatch?      @relation(fields: [organizationId, recoveryDispatchId], references: [organizationId, id], onDelete: Restrict)
  history            CommunicationAttempt[]

  @@unique([organizationId, id])
  @@unique([organizationId, messageId])
  @@unique([organizationId, messageId, conversationId])
  @@unique([organizationId, recoveryDispatchId])
  @@unique([organizationId, requestKey])
  @@unique([organizationId, provider, connectionId, externalId])
  @@index([status, availableAt])
}

model CommunicationAttempt {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  deliveryId     String                @db.Uuid
  eventKey       String
  status         String
  errorCode      String?
  externalId     String?
  occurredAt     DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  delivery       CommunicationDelivery @relation(fields: [organizationId, deliveryId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, deliveryId, eventKey])
}

model CommunicationSuppression {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  channel        String
  addressHash    String
  reason         String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, channel, addressHash])
}

model KnowledgeSource {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  name           String
  reference      String?
  active         Boolean             @default(true)
  revision       Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents      KnowledgeDocument[]
  entries        KnowledgeEntry[]

  @@unique([organizationId, id])
}

model KnowledgeDocument {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  sourceId       String           @db.Uuid
  filename       String
  content        String
  contentHash    String
  active         Boolean          @default(true)
  revision       Int              @default(1)
  createdBy      String
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  source         KnowledgeSource  @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Restrict)
  entries        KnowledgeEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, sourceId, id])
  @@unique([organizationId, sourceId, contentHash])
}

model KnowledgeEntry {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  sourceId          String             @db.Uuid
  documentId        String?            @db.Uuid
  category          String
  audience          String             @default("internal")
  active            Boolean            @default(false)
  revision          Int                @default(1)
  latestVersion     Int                @default(1)
  approvedVersionId String?            @db.Uuid
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  source            KnowledgeSource    @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Restrict)
  document          KnowledgeDocument? @relation(fields: [organizationId, sourceId, documentId], references: [organizationId, sourceId, id], onDelete: Restrict)
  versions          KnowledgeVersion[] @relation("EntryVersions")
  approvedVersion   KnowledgeVersion?  @relation("ApprovedKnowledge", fields: [organizationId, id, approvedVersionId], references: [organizationId, entryId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, active, category])
}

model KnowledgeVersion {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  entryId        String           @db.Uuid
  number         Int
  title          String
  question       String?
  content        String
  facts          Json
  risk           String
  createdBy      String
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entry          KnowledgeEntry   @relation("EntryVersions", fields: [organizationId, entryId], references: [organizationId, id], onDelete: Restrict)
  approvals      KnowledgeEntry[] @relation("ApprovedKnowledge")

  @@unique([organizationId, id])
  @@unique([organizationId, entryId, id])
  @@unique([organizationId, entryId, number])
}

enum OrganizationRole {
  owner
  admin
  member
  viewer
}

model OrganizationMember {
  recoveryHandoffs RecoveryHandoff[]
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @db.Uuid
  // Opaque verified identity subject; no passwords or self-asserted HTTP identity.
  subject          String
  role             OrganizationRole      @default(viewer)
  active           Boolean               @default(true)
  createdAt        DateTime              @default(now())
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  credentials      WorkforceCredential[]
  userId           String?               @db.Uuid
  displayName      String?
  user             User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments      CrmRecord[]

  @@unique([organizationId, id])
  @@unique([organizationId, subject])
  @@unique([organizationId, userId])
  @@map("OrganizationMembership")
}

model WorkforceCredential {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  membershipId   String?             @db.Uuid
  integrationId  String?             @db.Uuid
  tokenHash      String              @unique
  scopes         String[]
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership     OrganizationMember? @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  integration    ExternalConnection? @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
}

enum WorkforceIntegrationProvider {
  zapier
  generic_webhook
  ghl
}

model ExternalConnection {
  communicationAccount    CommunicationAccount?
  communicationDeliveries CommunicationDelivery[]
  recoveryPrograms        RecoveryProgram[]
  id                      String                  @id @default(uuid()) @db.Uuid
  organizationId          String                  @db.Uuid
  name                    String
  provider                String
  enabled                 Boolean                 @default(true)
  externalAccountId       String?
  webhookMapping          Json?
  businessEvents          BusinessEvent[]
  eventIntakes            EventIntake[]
  createdAt               DateTime                @default(now())
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  credentials             WorkforceCredential[]
  mappings                ExternalRecordMapping[]
  integrationActivity     IntegrationActivity[]

  @@unique([organizationId, id])
  @@unique([organizationId, id, provider])
  @@map("WorkforceIntegration")
}

model Contact {
