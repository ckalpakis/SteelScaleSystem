  value          Json
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  definition     CustomFieldDefinition @relation(fields: [organizationId, definitionId, entityType, fieldType], references: [organizationId, id, entityType, fieldType], onDelete: Restrict)
  record         CrmRecord             @relation(fields: [organizationId, recordId, entityType], references: [organizationId, id, entityType], onDelete: Restrict)

  @@unique([organizationId, definitionId, recordId])
  @@index([organizationId, recordId])
}

model RecordTag {
  organizationId String       @db.Uuid
  recordId       String       @db.Uuid
  tagId          String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  record         CrmRecord    @relation(fields: [organizationId, recordId], references: [organizationId, id], onDelete: Restrict)
  tag            Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, recordId, tagId])
}

model BusinessEventLink {
  organizationId String        @db.Uuid
  eventId        String        @db.Uuid
  recordId       String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event          BusinessEvent @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict)
  record         CrmRecord     @relation(fields: [organizationId, recordId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, eventId, recordId])
  @@index([organizationId, recordId, eventId])
}

// Completed DB-only handler effects and their receipt commit in the worker transaction.
model EventDelivery {
  organizationId String        @db.Uuid
  eventId        String        @db.Uuid
  handlerId      String
  processedAt    DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event          BusinessEvent @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, eventId, handlerId])
}

// Receipt precedes normalization/projection. One delivery can generate several domain facts.
model EventIntake {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  source         String
  externalId     String
  payloadHash    String
  connectionId   String?             @db.Uuid
  eventId        String?             @db.Uuid
  result         Json
  receivedAt     DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connection     ExternalConnection? @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Restrict)
  event          BusinessEvent?      @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, source, externalId])
}

model WebhookEndpoint {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  name               String
  host               String
  encryptedUrl       String
  encryptedSecret    String
  events             String[]
  includeExternal    Boolean            @default(false)
  includeContactData Boolean            @default(false)
  enabled            Boolean            @default(true)
  createdAt          DateTime           @default(now())
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deliveries         OutboundDelivery[]

  @@unique([organizationId, id])
}

model OutboundDelivery {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  endpointId       String            @db.Uuid
  eventId          String?           @db.Uuid
  deduplicationKey String
  payload          Json
  status           String            @default("pending")
  attempts         Int               @default(0)
  attemptsAllowed  Int               @default(8)
  availableAt      DateTime          @default(now())
  leaseToken       String?           @db.Uuid
  leasedUntil      DateTime?
  lastErrorCode    String?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  endpoint         WebhookEndpoint   @relation(fields: [organizationId, endpointId], references: [organizationId, id], onDelete: Restrict)
  event            BusinessEvent?    @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict)
  history          OutboundAttempt[]

  @@unique([organizationId, id])
  @@unique([organizationId, endpointId, deduplicationKey])
  @@index([status, availableAt])
  @@index([organizationId, createdAt])
}

model OutboundAttempt {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  deliveryId     String           @db.Uuid
  attempt        Int
  statusCode     Int?
  errorCode      String?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  delivery       OutboundDelivery @relation(fields: [organizationId, deliveryId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, deliveryId, attempt])
}

model IntegrationActivity {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  connectionId   String             @db.Uuid
  payloadHash    String
  summary        Json
  statusCode     Int
  code           String
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connection     ExternalConnection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, createdAt])
}

model OrganizationWebhookLimit {
  organizationId String       @id @db.Uuid
  window         DateTime
  count          Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}
