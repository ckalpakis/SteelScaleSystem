  no_answer
  not_interested
  voicemail
}

enum BookingSource {
  voice
  chatbot
  sms
}

enum SmsConversationStatus {
  active
  booked
  opted_out
}

enum SmsDirection {
  inbound
  outbound
}

enum BookingStatus {
  pending
  success
  failed
}

enum SmsAttemptStatus {
  pending
  sent
  failed
}

enum ChatRole {
  user
  assistant
  tool
}

enum ChatSessionStatus {
  active
  booked
}

enum LeadLifecycleStatus {
  new
  qualified
  disqualified
  contacted
  converted
  archived
}

enum IntelligenceRunStatus {
  pending
  running
  completed
  failed
  partially_completed
}

enum IntelligenceOffer {
  VOICE_AI
  REAL_ESTATE_VIDEO
  WEBSITE
  SEO_RANKING
  REVIEWS
}

enum ProspectRelationshipStatus {
  prospect
  current_customer
  former_customer
  partner
  do_not_target
}

enum OutreachDisposition {
  not_contacted
  ready
  paused
  contacted
  replied
  qualified
  converted
  do_not_contact
  invalid
