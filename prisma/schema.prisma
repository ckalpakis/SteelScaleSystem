enum OutreachChannel {
  phone
  sms
  email
  social
  other
}

enum OutreachDirection {
  outbound
  inbound
}

enum DeliveryDestination {
  GHL
  ZAPIER_WEBHOOK
  CSV_EXPORT
  CALL_QUEUE
}

enum DeliveryStatus {
  pending
  processing
  delivered
  failed
}

enum ConsentStatus {
  unknown
  granted
  denied
  opted_out
