{
  "name": "steel-scale-system",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant missed-call and booking automation service.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p prisma/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "test:missed-call": "tsx scripts/simulate-missed-call.ts",
    "test:vapi-booking": "tsx scripts/simulate-vapi-booking.ts",
    "test:chatbot": "tsx scripts/simulate-chatbot-booking.ts",
    "test:booking-routing": "tsx scripts/simulate-booking-routing.ts",
    "test:admin": "tsx scripts/test-admin.ts",
    "test:daily-summary": "tsx scripts/test-daily-summary.ts",
    "test:lead-intelligence-phase-1": "tsx scripts/test-lead-intelligence-phase-1.ts",
    "test:lead-intelligence-phase-2": "tsx scripts/test-lead-intelligence-phase-2.ts",
    "import:outscraper": "tsx scripts/import-outscraper-google-maps.ts",
    "test:lead-intelligence-phase-3": "tsx scripts/test-lead-intelligence-phase-3.ts",
    "audit:websites": "tsx scripts/audit-business-websites.ts",
    "test:lead-intelligence-phase-4": "tsx scripts/test-lead-intelligence-phase-4.ts",
    "test:lead-intelligence-phase-5": "tsx scripts/test-lead-intelligence-phase-5.ts",
    "test:lead-intelligence-phase-6": "tsx scripts/test-lead-intelligence-phase-6.ts",
    "test:lead-intelligence-phase-7": "tsx scripts/test-lead-intelligence-phase-7.ts",
    "test:lead-intelligence-phase-8": "tsx scripts/test-lead-intelligence-phase-8.ts",
    "test:lead-intelligence-phase-9": "tsx scripts/test-lead-intelligence-phase-9.ts",
    "test:lead-intelligence-phase-10": "tsx scripts/test-lead-intelligence-phase-10.ts",
    "test:lead-intelligence-phase-11": "tsx scripts/test-lead-intelligence-phase-11.ts",
    "test:lead-intelligence-analyst": "tsx scripts/test-lead-intelligence-analyst.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^6.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
