{
  "name": "steel-scale-system",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant missed-call and booking automation service.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:workforce-worker": "node dist/workforce/jobs/worker.js",
    "test:deployment": "node --import tsx --test src/platform/core.test.ts",
    "test:workspace": "node --import tsx --test src/workspace/core.test.ts",
    "test:workspace:integration": "node --import tsx --test --test-concurrency=1 src/workspace/integration.test.ts",
    "test:workspace:browser": "node --import tsx scripts/test-workspace-browser.ts",
    "test:deployment:integration": "node --import tsx --test --test-concurrency=1 src/platform/integration.test.ts",
    "test:deployment:redis": "node --import tsx --test --test-concurrency=1 src/platform/redis.integration.test.ts",
    "test:deployment:process": "node --import tsx --test src/platform/process.integration.test.ts",
    "ops:queues": "node dist/platform/inspect.js",
    "test:workforce": "node --import tsx --test src/workforce/core.test.ts",
    "test:workforce:integration": "node --import tsx --test --test-concurrency=1 src/workforce/foundation.integration.test.ts",
    "test:crm": "node --import tsx --test src/crm/core.test.ts",
    "test:crm:integration": "node --import tsx --test --test-concurrency=1 src/crm/integration.test.ts",
    "test:crm:browser": "node --import tsx scripts/test-crm-browser.ts",
    "test:crm:migration": "node --import tsx scripts/test-crm-migration.ts",
    "test:events": "node --import tsx --test src/events/core.test.ts",
    "test:events:integration": "node --import tsx --test --test-concurrency=1 src/events/integration.test.ts",
    "test:integrations": "node --import tsx --test src/integrations/core.test.ts",
    "test:agents": "node --import tsx --test src/agents/core.test.ts",
    "test:agent-builder": "node --import tsx --test src/agent-builder/core.test.ts",
    "test:recovery": "node --import tsx --test src/recovery/core.test.ts",
    "test:knowledge": "node --import tsx --test src/knowledge/core.test.ts",
    "test:knowledge:integration": "node --import tsx --test --test-concurrency=1 src/knowledge/integration.test.ts",
    "test:knowledge:browser": "node --import tsx scripts/test-knowledge-browser.ts",
    "test:communications": "node --import tsx --test src/communications/core.test.ts",
    "test:communications:integration": "node --import tsx --test --test-concurrency=1 src/communications/integration.test.ts",
    "test:recovery:communications": "COMMUNICATIONS_ENABLED=true npm run test:recovery:integration",
    "test:recovery:integration": "node --import tsx --test --test-concurrency=1 src/recovery/integration.test.ts",
    "test:recovery:browser": "node --import tsx scripts/test-recovery-browser.ts",
    "test:agent-builder:integration": "node --import tsx --test --test-concurrency=1 src/agent-builder/integration.test.ts",
    "test:agent-builder:browser": "node --import tsx scripts/test-agent-builder-browser.ts",
    "test:agents:integration": "node --import tsx --test --test-concurrency=1 src/agents/integration.test.ts",
    "test:integrations:browser": "node --import tsx scripts/test-integrations-browser.ts",
    "test:integrations:integration": "node --import tsx --test --test-concurrency=1 src/integrations/integration.test.ts",
    "test:regressions": "tsx scripts/test-workforce-regressions.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p prisma/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "test:missed-call": "tsx scripts/simulate-missed-call.ts",
    "test:vapi-booking": "tsx scripts/simulate-vapi-booking.ts",
    "test:chatbot": "tsx scripts/simulate-chatbot-booking.ts",
    "test:booking-routing": "tsx scripts/simulate-booking-routing.ts",
    "test:admin": "tsx scripts/test-admin.ts",
    "test:daily-summary": "tsx scripts/test-daily-summary.ts",
    "test:lead-intelligence-phase-1": "tsx scripts/test-lead-intelligence-phase-1.ts",
    "test:lead-intelligence-phase-2": "tsx scripts/test-lead-intelligence-phase-2.ts",
    "import:outscraper": "tsx scripts/import-outscraper-google-maps.ts",
    "test:lead-intelligence-phase-3": "tsx scripts/test-lead-intelligence-phase-3.ts",
    "audit:websites": "tsx scripts/audit-business-websites.ts",
    "test:lead-intelligence-phase-4": "tsx scripts/test-lead-intelligence-phase-4.ts",
    "test:lead-intelligence-phase-5": "tsx scripts/test-lead-intelligence-phase-5.ts",
    "test:lead-intelligence-phase-6": "tsx scripts/test-lead-intelligence-phase-6.ts",
    "test:lead-intelligence-phase-7": "tsx scripts/test-lead-intelligence-phase-7.ts",
    "test:lead-intelligence-phase-8": "tsx scripts/test-lead-intelligence-phase-8.ts",
    "test:lead-intelligence-phase-9": "tsx scripts/test-lead-intelligence-phase-9.ts",
    "test:lead-intelligence-phase-10": "tsx scripts/test-lead-intelligence-phase-10.ts",
    "test:lead-intelligence-phase-11": "tsx scripts/test-lead-intelligence-phase-11.ts",
    "test:lead-intelligence-analyst": "tsx scripts/test-lead-intelligence-analyst.ts",
    "test:lead-discovery-providers": "tsx scripts/test-lead-discovery-providers.ts",
    "test:ghl-availability": "tsx scripts/test-ghl-availability.ts",
    "test:demos": "node --import tsx --test src/demo-engine/core.test.ts src/demo-engine/live-provider.test.ts",
    "test:demos:integration": "node --import tsx --test --test-concurrency=1 src/demo-engine/routes.integration.test.ts src/demo-engine/live.integration.test.ts",
    "test:demos:browser": "node --import tsx scripts/test-demo-experience.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bullmq": "^5.81.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "prisma": "^6.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
