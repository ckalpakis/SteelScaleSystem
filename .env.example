DATABASE_URL="postgresql://postgres:postgres@localhost:5432/steel_scale?schema=public"
NODE_ENV="development"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_SMS_DRY_RUN=false
VAPI_API_KEY="your_vapi_api_key"
VAPI_WEBHOOK_SECRET="your_vapi_webhook_secret"
LLM_PROVIDER="openai"
LLM_MODEL="gpt-5.4-nano"
OPENAI_API_KEY="your_openai_api_key"
LEAD_ANALYST_MODEL="gpt-5.4-nano"
OUTSCRAPER_API_KEY="your_outscraper_api_key"
APIFY_API_TOKEN="your_apify_api_token"
APIFY_ZILLOW_SEARCH_ACTOR_ID="maxcopell/zillow-scraper"
APIFY_ZILLOW_DETAIL_ACTOR_ID="maxcopell/zillow-detail-scraper"
ANTHROPIC_API_KEY="your_anthropic_api_key"
GHL_API_KEY="your_ghl_api_key"
GHL_LOCATION_ID="your_ghl_location_id"
GHL_FALLBACK_CALENDAR_ID="your_safety_net_ghl_calendar_id"
GHL_API_BASE_URL="https://services.leadconnectorhq.com"
BOOKING_DELIVERY_DRY_RUN=false
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace_with_a_long_random_password"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/your/incoming/webhook"
CRON_SECRET="replace_with_a_long_random_cron_secret"
# JSON array of enabled pipeline campaigns. Discovery providers are registered at application startup.
LEAD_PIPELINE_CAMPAIGNS_JSON='[]'
PORT=3000
# On-demand demo engine; enable only after local/staging migration and verification.
DEMO_ENGINE_ENABLED=false
DEMO_AI_ENABLED=false
DEMO_VOICE_ENABLED=false
# Optional demo-only OpenAI project key; falls back to OPENAI_API_KEY. Never public.
DEMO_OPENAI_API_KEY=""
DEMO_CHAT_MODEL="gpt-4.1-mini"
DEMO_VOICE_MODEL="gpt-realtime-mini"
# Additive workforce API. Deploy migration and verify staging before enabling.
WORKFORCE_ENABLED=false
# Set only on a separate worker service running npm run start:workforce-worker.
WORKFORCE_WORKER_ENABLED=false
WEBHOOK_DELIVERY_ENABLED=false
# Exactly 64 random hex characters (32 bytes). Required to configure/send outbound webhooks.
# Keep stable across API/worker replicas; never commit the actual key.
INTEGRATION_ENCRYPTION_KEY=
# Canonical CRM API and internal admin UI; requires WORKFORCE_ENABLED=true.
CRM_ENABLED=false
# Universal agent runtime is additive; enable only after the migration and staging checks.
AGENT_RUNTIME_ENABLED=false
# Paid model calls are separately disabled. No automatic model fallback.
AGENT_MODEL_ENABLED=false
# Comma-separated operator-reviewed model IDs supporting Responses strict structured output.
AGENT_ALLOWED_MODELS=
# Natural-language builder and its separately gated paid extraction calls.
AGENT_BUILDER_ENABLED=false
AGENT_BUILDER_AI_ENABLED=false
# Must also appear in AGENT_ALLOWED_MODELS. No inferred model or API endpoint.
AGENT_BUILDER_MODEL=
# Universal recovery specialization and its separately gated adapter claims.
REVENUE_RECOVERY_ENABLED=false
REVENUE_RECOVERY_DELIVERY_ENABLED=false
# Shared reviewed business facts. Enabling requires linking recovery text to approved versions.
BUSINESS_KNOWLEDGE_ENABLED=false
# Canonical communication API/ledger and separate native sender worker gate.
COMMUNICATIONS_ENABLED=false
COMMUNICATION_DELIVERY_ENABLED=false
# Railway process split. Stage migration and worker before enabling on BOTH services.
DURABLE_BACKGROUND_ENABLED=false
SERVICE_ROLE=web
# Private Redis reference on worker only. Never expose Redis publicly.
REDIS_URL=
QUEUE_PREFIX=steel-scale
DB_CONNECTION_LIMIT=5
WORKER_BATCH_SIZE=10
SHUTDOWN_TIMEOUT_MS=25000
